# Supabase project credentials — copy this file to .env.local and fill it in.
# Both values are public by design: the anon key identifies the project, and
# row-level security is what actually protects the data. Never put the
# service_role key in this file; it bypasses RLS entirely.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
